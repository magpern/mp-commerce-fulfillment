{
    "name": "magpern/mp-commerce-fulfillment",
    "description": "Commerce Fulfillment for WooCommerce. WooCommerce remains the order source; this plugin owns warehouse workflow, picking, packing, shipping, tracking, documents and audit from paid to delivered.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.6",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "wp-phpunit/wp-phpunit": "^6.5 || ^7.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MPCF\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MPCF\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "make-pot": "bash bin/make-pot.sh",
        "make-pot:check": "bash bin/make-pot.sh --check",
        "test:unit": "phpunit -c phpunit.xml.dist",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "release-audit": "bash bin/release-audit.sh",
        "sync-mpds": "bash bin/sync-mpds.sh"
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
